# backend/.env.example
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to git.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
APP_NAME=Koha OPAC AI Assistant
APP_VERSION=1.0.1
DEBUG=False
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# CORS — comma-separated list of allowed origins, or * for all
# For production, restrict to your Koha OPAC domain:
#   ALLOWED_ORIGINS=https://your-koha-domain.example.com
# -----------------------------------------------------------------------
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------
# Database (Koha MariaDB)
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=koha_library
DB_USER=koha_library
DB_PASSWORD=your_database_password_here

# -----------------------------------------------------------------------
# Search Engine
# Supported values: auto | sql | zebra | elasticsearch
# "auto" defaults to SQL (always available).
# -----------------------------------------------------------------------
SEARCH_ENGINE=sql

# -----------------------------------------------------------------------
# Elasticsearch (optional — only needed if SEARCH_ENGINE=elasticsearch)
# -----------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------
# Koha REST API (optional — for future features)
# -----------------------------------------------------------------------
KOHA_URL=http://localhost:8080
KOHA_API_URL=http://localhost:8081
KOHA_API_USER=
KOHA_API_PASSWORD=

# -----------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------
TIMEOUT=10
