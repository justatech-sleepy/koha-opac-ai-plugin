# backend/.env.example
# Copy this file to backend/.env and fill in your values.
# NEVER commit backend/.env to git.

# -----------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------
APP_NAME=Koha OPAC AI Assistant
APP_VERSION=1.0.1
DEBUG=False
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# CORS — comma-separated list of allowed origins, or * for all
# Server & CORS Configuration
# -----------------------------------------------------------------------
# IMPORTANT SECURITY: Set this to the exact URL of your Koha OPAC in production
# to prevent cross-origin theft of your API quota (e.g., https://catalog.mylibrary.com).
# Comma-separated list of origins.
ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

# -----------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=koha_library
DB_USER=koha_library
DB_PASSWORD=your_database_password_here

# -----------------------------------------------------------------------
# Search Engine
# Supported values: auto | sql | zebra | elasticsearch
# "auto" defaults to SQL (always available).
# -----------------------------------------------------------------------
SEARCH_ENGINE=sql

# -----------------------------------------------------------------------
# Elasticsearch (optional — only needed if SEARCH_ENGINE=elasticsearch)
# -----------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------
# Koha REST API (optional — for future features)
# -----------------------------------------------------------------------
KOHA_URL=http://localhost:8080
KOHA_API_URL=http://localhost:8081
KOHA_API_USER=
KOHA_API_PASSWORD=

# -----------------------------------------------------------------------
# Timeouts
# -----------------------------------------------------------------------
TIMEOUT=10

# -----------------------------------------------------------------------
# LLM API (OpenAI or Gemini)
# -----------------------------------------------------------------------
LLM_PROVIDER=openai

# OpenAI Settings
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini Settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
